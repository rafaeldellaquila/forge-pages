# forge-pages always-on services — VPS environment (copy to forge-services.env on the VM).
# forge-services.env is gitignored; real values live ONLY on the VM, never in the repo.
# The Strapi block mirrors the CMS_VARS set that `mise run env:sync` writes to apps/cms/.env.

# ══ Strapi (cms) ═════════════════════════════════════════════════════════════════
# ── Secrets: generate FRESH values on the VM (never reuse local-dev or prod) ──────
#   for i in 1 2 3 4 5 6; do openssl rand -base64 16; done
APP_KEYS=            # two values, comma-separated
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ── Database ─────────────────────────────────────────────────────────────────────
# Smoke test: DB config comes from docker-compose.smoke.yml (throwaway Postgres), so
# leave these blank. The image ships only the `pg` driver (not better-sqlite3).
# Real deploy: set DATABASE_URL to the cloud Supabase connection string (the individual
# fields below are ignored when DATABASE_URL is set).
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_URL=

# ── Media storage (real deploy only) ──────────────────────────────────────────────
# Empty → Strapi uploads to local disk (cms-uploads volume). Fill for the real pass.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=sa-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=landing-page-assets
SUPABASE_S3_BASE_URL=

# ── Observability (optional) ───────────────────────────────────────────────────────
SENTRY_DSN=

# ══ NocoDB (nocodb) ══════════════════════════════════════════════════════════════
# Public URL is the Cloudflare-Tunnel hostname (used for invite links / OAuth redirects).
NC_PUBLIC_URL=https://db.forgecompany.example.com
# Sign JWTs for NocoDB sessions — generate: openssl rand -base64 32
NC_AUTH_JWT_SECRET=
# Optional: point NocoDB's OWN metadata at Supabase instead of the local nocodb-data
# volume. Leave blank to keep metadata local and add Supabase as a data source in-app
# (recommended — keeps NocoDB's tables out of the app schema).
#   NC_DB=pg://HOST:5432?u=USER&p=PASSWORD&d=DBNAME
NC_DB=

# ══ Flipt (flipt) ════════════════════════════════════════════════════════════════
# Flag state is read from ../flipt (mounted read-only); no env needed here.
