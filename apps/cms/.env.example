# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate with: openssl rand -base64 16
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database (Supabase Postgres)
# Local dev: point at the local Supabase stack (supabase start --workdir infra)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54322
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
# Prod: set DATABASE_URL instead (overrides the individual fields above)
DATABASE_URL=

# Supabase Storage (media uploads, S3-compatible endpoint)
# Get S3 credentials from Supabase dashboard → Storage → S3 Connection
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=sa-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=landing-page-assets
# Public base URL for serving assets (e.g. https://<ref>.supabase.co/storage/v1/object/public)
SUPABASE_S3_BASE_URL=

# Sentry
SENTRY_DSN=

# Flipt
FLIPT_URL=
FLIPT_TOKEN=
