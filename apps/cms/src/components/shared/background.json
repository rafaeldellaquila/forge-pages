{
  "collectionName": "components_shared_backgrounds",
  "info": {
    "displayName": "Background",
    "icon": "brush",
    "description": "Optional per-block background override — inherits the page background when unset"
  },
  "options": {},
  "attributes": {
    "type": {
      "type": "enumeration",
      "enum": ["transparent", "solid", "gradient", "image", "fine-line-texture", "glass"],
      "default": "transparent"
    },
    "colorToken": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "custom"],
      "default": "primary"
    },
    "customColor": {
      "type": "string",
      "customField": "plugin::color-picker.color"
    },
    "gradientToToken": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "custom"]
    },
    "gradientToCustom": {
      "type": "string",
      "customField": "plugin::color-picker.color"
    },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "effect": {
      "type": "enumeration",
      "enum": ["none", "particles"],
      "default": "none"
    }
  }
}
