# Strapi (CMS) — server-side only
STRAPI_URL=
STRAPI_API_TOKEN=

# Supabase — publishable key is public; secret key is server-side only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Upstash Redis — lead rate limiting (Phase 5)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — bot protection (Phase 5)
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# PostHog — analytics (Phase 5). Use the public Project API Key (phc_...).
# Host is region-specific: https://us.i.posthog.com or https://eu.i.posthog.com
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=

# Sentry — error tracking (Phase 5). SENTRY_AUTH_TOKEN only needed for prod source-map upload.
NUXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Flipt — feature flags (Phase 5). Fail-open if unreachable.
FLIPT_URL=
FLIPT_TOKEN=

# Domainee — custom-domain SSL (server-side only)
DOMAINEE_API_KEY=

# Admin API token — guards internal endpoints (e.g. /api/admin/domains)
ADMIN_API_TOKEN=
