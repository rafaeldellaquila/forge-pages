# forge-pages — Environment Variables
# Copy this file reference when setting up external services.
# NEVER add real values here. NEVER commit a .env file with real values.
# Dev: export variables from shell or use mise env hooks pointing to an external source.
# Prod: inject via Koyeb dashboard and Supabase dashboard.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Database → Connection string (for pg_dump backup)
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=

# ─── Strapi ──────────────────────────────────────────────────────────────────
# URL where Strapi is running (Koyeb deployment URL)
STRAPI_URL=

# Read-only API token created in Strapi admin → Settings → API Tokens
STRAPI_API_TOKEN=

# Strapi internal secrets (generated on first run, keep private)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# ─── Nuxt ────────────────────────────────────────────────────────────────────
NUXT_SECRET_KEY=
NUXT_PUBLIC_SITE_URL=              # e.g. https://forge-pages.com.br

# ─── Upstash Redis ───────────────────────────────────────────────────────────
# console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_API_TOKEN=
# ─── Cloudflare Turnstile ────────────────────────────────────────────────────
# dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUD_FLARE_ACCOUNT_ID=
CLOUD_FLARE_API_TOKEN=
CLOUD_FLARE_ACCESS_KEY_ID=
CLOUD_FLARE_SECRET_ACCESS_KEY=
CLOUD_FLARE_S3_API_URL=
# ─── Resend ──────────────────────────────────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=                 # e.g. noreply@forge-pages.com.br
RESEND_NOTIFICATION_EMAIL=        # internal email that receives lead alerts

# ─── WhatsApp Cloud API ──────────────────────────────────────────────────────
# developers.facebook.com → WhatsApp → Getting Started
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFICATION_NUMBER=      # number that receives lead alerts (with DDI, e.g. 5511999999999)

# ─── PostHog ─────────────────────────────────────────────────────────────────
# app.posthog.com → Project Settings
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=          # https://app.posthog.com

# ─── Sentry ──────────────────────────────────────────────────────────────────
# sentry.io → Project → Settings → Client Keys
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NUXT_PUBLIC_SENTRY_DSN=            # same value as SENTRY_DSN (public, client-side)

# ─── Flipt ───────────────────────────────────────────────────────────────────
# Self-hosted Flipt instance on Koyeb
FLIPT_URL=                         # e.g. https://flipt-<hash>.koyeb.app
FLIPT_TOKEN=                       # Flipt → Settings → API Tokens

# ─── Domainee ────────────────────────────────────────────────────────────────
# domainee.io → API Keys
DOMAINEE_API_KEY=

# ─── Claude (for CI PR review workflow) ──────────────────────────────────────
# anthropic.com → API Keys
# Only needed in GitHub Actions — not in local dev
ANTHROPIC_API_KEY=

GITHUB_PERSONAL_ACCESS_TOKEN=