# forge-pages — Environment Variables
# The root .env is the SINGLE source of truth for local env vars:
#   cp .env.example .env        → fill in the blanks (or run the onboard-local skill)
#   mise run env:sync           → regenerates apps/web/.env + apps/cms/.env (never edit those)
# mise auto-loads the root .env for all tasks and the activated shell.
# NEVER commit a .env with real values. Prod values never live in local files —
# they go to GitHub Actions secrets / Cloudflare / Supabase dashboards.
# Full variable → consumer → dev/prod matrix: docs/SECRETS.md
# Non-secret local-dev defaults are pre-filled below.

# ═══ WEB (Nuxt) — synced to apps/web/.env ════════════════════════════════════
# Empty optional integrations = graceful no-op (see docs/LOCAL_DEVELOPMENT.md §9).

# Local Strapi; token: Strapi admin → Settings → API Tokens → Read-only
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Local Supabase stack; keys printed by: pnpm exec supabase status --workdir infra
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_... (public, client-side reads)
SUPABASE_SECRET_KEY=               # sb_secret_... (server-side only, bypasses RLS)

NUXT_PUBLIC_SITE_URL=              # prod: https://forgecompany.example.com (also used by Strapi CORS)

# console.upstash.com → Redis → REST API (empty → rate limiting skipped)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=          # the ~60+ char REST token, NOT the DB password

# dash.cloudflare.com → Turnstile (empty → bot check skipped)
# Dev: always-pass test keys — site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# PostHog project → public Project API Key (phc_...); host is region-specific
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=          # https://us.i.posthog.com or https://eu.i.posthog.com

# Sentry project DSN (empty → Sentry no-op; keep empty in local dev)
NUXT_PUBLIC_SENTRY_DSN=

# Flipt feature flags (empty → fails open, all flags enabled)
FLIPT_URL=
FLIPT_TOKEN=

# ═══ CMS (Strapi) — synced to apps/cms/.env ══════════════════════════════════
# Secrets: generate each with `openssl rand -base64 16` (setup.sh does this).
# Changing APP_KEYS/ADMIN_JWT_SECRET invalidates local Strapi admin sessions.
APP_KEYS=                          # two values, comma-separated
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Local Supabase Postgres (HOST/PORT of Strapi itself default to 0.0.0.0:1337)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54322
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
# Prod only: full connection string overrides the fields above
DATABASE_URL=

# Supabase Storage S3 endpoint (dashboard → Storage → S3 Connection);
# empty → Strapi uploads to local disk
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=sa-east-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=landing-page-assets
SUPABASE_S3_BASE_URL=              # https://<ref>.supabase.co/storage/v1/object/public

# Sentry DSN for Strapi (keep empty in local dev)
SENTRY_DSN=

# ═══ CLOUD OPS — this machine only, never synced to apps ═════════════════════
# CLI/tooling credentials for operating the cloud infra.

# Supabase cloud project (Forge Company account) — for CLI link + backup pg_dump
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=

# Cloudflare — Workers/Pages deploy token (needs "Cloudflare Pages: Edit")
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Sentry — source-map upload token (prod builds only)
SENTRY_AUTH_TOKEN=

# Anthropic — CI PR-review workflow only (GitHub Actions secret, not local dev)
ANTHROPIC_API_KEY=

# GitHub fine-grained PAT — repo automation (Contents/PRs/Workflows/Actions R/W)
GITHUB_PERSONAL_ACCESS_TOKEN=

# ═══ EDGE FUNCTION SECRETS — live in Supabase (functions secrets); local mirror ═
# Set via: supabase secrets set --workdir infra (or dashboard → Edge Functions)
RESEND_API_KEY=
RESEND_FROM_EMAIL=                 # e.g. leads@send.forgecompany.example.com (verified sender domain)
RESEND_NOTIFICATION_EMAIL=         # internal inbox for lead alerts, e.g. contato@forgecompany.example.com
WHATSAPP_ACCESS_TOKEN=             # empty → WhatsApp channel skipped by the Edge Function
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFICATION_NUMBER=      # receives lead alerts, with DDI, e.g. 5511999999999
