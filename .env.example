# forge-pages — Environment Variables
# The root .env is the SINGLE source of truth for local env vars:
#   cp .env.example .env        → fill in the blanks (or run the onboard-local skill)
# mise auto-loads the root .env for all tasks and the activated shell, and Next.js
# reads it natively from the project root (no per-app sync since ADR-0007).
# NEVER commit a .env with real values. Prod values never live in local files —
# they go to GitHub Actions secrets / Cloudflare / Supabase dashboards.
# Full variable → consumer → dev/prod matrix: docs/SECRETS.md
# Non-secret local-dev defaults are pre-filled below.
# Keep values bare in your .env: no surrounding quotes and no inline # comments —
# mise's dotenv parser captures them verbatim as part of the value.

# ═══ APP ═════════════════════════════════════════════════════════════════════
# Empty optional integrations = graceful no-op.
# NEXT_PUBLIC_* vars are inlined into the client bundle — never put a secret there.

# Local Supabase stack; keys printed by: pnpm exec supabase status --workdir infra
SUPABASE_URL=http://127.0.0.1:54321
# sb_publishable_... (public, safe for client-side reads)
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... (server-side only, bypasses RLS — never behind NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=


# dash.cloudflare.com → Turnstile (empty → bot check skipped)
# Dev: always-pass test keys — site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ═══ CLOUD OPS — this machine only ═══════════════════════════════════════════
# CLI/tooling credentials for operating the cloud infra.

# Supabase cloud project (Forge Company account) — for CLI link + backup pg_dump
# Personal access token (dashboard → Account → Access Tokens); lets the CLI +
# Management API authenticate headlessly (mise auto-loads it).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=
SUPABASE_DB_PASSWORD=

# Cloudflare — Workers deploy token (needs "Workers Scripts: Edit")
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Anthropic — CI PR-review workflow only (GitHub Actions secret, not local dev)
ANTHROPIC_API_KEY=

# GitHub fine-grained PAT — repo automation (Contents/PRs/Workflows/Actions R/W)
GITHUB_PERSONAL_ACCESS_TOKEN=

# ═══ PROD (cloud Supabase) — mirrors the GitHub Actions secrets ══════════════
# Project ofpnglnnzpowlzsyfbit (org Forge Company) — the only cloud project this
# repo targets. NOT loaded by local dev (local = dev); kept here so the deploy
# values live in one place. See docs/SECRETS.md and .github/SETUP.md.
PROD_SUPABASE_URL=
PROD_SUPABASE_PUBLISHABLE_KEY=
PROD_SUPABASE_SECRET_KEY=
